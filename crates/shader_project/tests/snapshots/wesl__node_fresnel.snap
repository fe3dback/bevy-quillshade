import bevy_pbr::render::forward_io::VertexOutput;
import bevy_pbr::render::mesh_view_bindings::view;
import super::super::stdlib::shading::sg_fresnel;

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    // --- builtins ---
    let b_world_position: vec3<f32> = in.world_position.xyz;
    let b_world_normal: vec3<f32> = normalize(in.world_normal);
    let b_camera_position: vec3<f32> = view.world_position;
    // --- graph ---
    let n_n02_out: f32 = sg_fresnel(b_world_normal, normalize(b_camera_position - b_world_position), 5.0f, 0.04f);
    // --- outputs ---
    let color: vec3<f32> = vec3<f32>(n_n02_out);
    let alpha: f32 = 1.0;
    return vec4<f32>(color, alpha);
}
