// AUTOGENERATED by shader-editor v1 from shaders/ui/dissolve.material.ron — do not edit
use bevy::color::ColorToComponents;
use bevy::sprite_render::{AlphaMode2d, MaterialExtension2d, SpriteMaterialPlugin};
use bevy::prelude::*;
use bevy::render::render_resource::{AsBindGroup, ShaderType};
use bevy::shader::ShaderRef;

/// Asset path of the generated shader.
pub const SHADER_PATH: &str = "shaders/autogen/dir_ui/mat_dissolve.wesl";

/// Uniform block at `@binding(100)`; layout matches `DissolveParams` in WESL (32 bytes).
#[derive(ShaderType, Reflect, Debug, Clone, Copy, PartialEq)]
pub struct DissolveParams {
    pub inp_edge_color: Vec4,
    pub inp_amount: f32,
    pub inp_edge_width: f32,
    pub _pad0: f32,
    pub _pad1: f32,
}

impl Default for DissolveParams {
    /// Default values from the graph.
    fn default() -> Self {
        Self {
            inp_edge_color: Vec4::new(1.0, 0.6, 0.1, 1.0),
            inp_amount: 0.4,
            inp_edge_width: 0.05,
            _pad0: 0.0,
            _pad1: 0.0,
        }
    }
}

/// Sprite material: add `SpriteMaterial(handle)` next to `Sprite`.
#[derive(Asset, AsBindGroup, Reflect, Debug, Clone)]
pub struct DissolveMaterial {
    #[uniform(100)]
    pub params: DissolveParams,
}

impl MaterialExtension2d for DissolveMaterial {
    fn fragment_shader() -> Option<ShaderRef> {
        Some(SHADER_PATH.into())
    }

    fn alpha_mode(&self) -> Option<AlphaMode2d> {
        Some(AlphaMode2d::Blend)
    }
}

impl DissolveMaterial {
    /// All graph parameters are required; order = parameter order in the editor:
    /// - `inp_amount`, UI range 0.0..1.0
    /// - `inp_edge_color`
    /// - `inp_edge_width`, UI range 0.0..1.0
    pub fn new(inp_amount: f32, inp_edge_color: LinearRgba, inp_edge_width: f32) -> Self {
        Self {
            params: DissolveParams {
                inp_edge_color: inp_edge_color.to_vec4(),
                inp_amount,
                inp_edge_width,
                _pad0: 0.0,
                _pad1: 0.0,
            },
        }
    }

    pub fn set_inp_amount(&mut self, v: f32) {
        self.params.inp_amount = v;
    }

    pub fn set_inp_edge_color(&mut self, v: LinearRgba) {
        self.params.inp_edge_color = v.to_vec4();
    }

    pub fn set_inp_edge_width(&mut self, v: f32) {
        self.params.inp_edge_width = v;
    }
}

pub(crate) fn register(app: &mut App) {
    app.add_plugins(SpriteMaterialPlugin::<DissolveMaterial>::default());
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn uniform_layout_matches_wesl() {
        assert_eq!(DissolveParams::min_size().get(), 32);
    }
}
