import bevy_pbr::render::mesh_view_bindings::view;

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    // --- builtins ---
    let b_world_position: vec3<f32> = in.world_position.xyz;
    let b_view_from_world: mat4x4<f32> = view.view_from_world;
    // --- graph ---
    let n_n02_out: f32 = -(b_view_from_world * vec4<f32>(b_world_position, 1.0)).z;
