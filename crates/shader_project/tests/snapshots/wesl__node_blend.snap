    let n_n02_out: vec3<f32> = sg_srgb_to_linear(mix(n_n02_base_, sg_blend_overlay(n_n02_base_, sg_linear_to_srgb(vec3<f32>(0.5, 0.5, 0.5))), 1.0f));
    // --- outputs ---
    let color: vec3<f32> = n_n02_out;
    let alpha: f32 = 1.0;
    return vec4<f32>(color, alpha);
}
