// AUTOGENERATED by shader-editor v1 from shaders/env/terrain_layers.material.ron — do not edit
use bevy::pbr::{ExtendedMaterial, MaterialExtension};
use bevy::prelude::*;
use bevy::render::render_resource::{AsBindGroup};
use bevy::shader::ShaderRef;

/// Asset path of the generated shader.
pub const SHADER_PATH: &str = "shaders/autogen/dir_env/mat_terrain_layers.wesl";

/// Extension of `StandardMaterial`; use [`TerrainLayersMaterial`] as the asset type.
#[derive(Asset, AsBindGroup, Reflect, Debug, Clone, Default)]
pub struct TerrainLayersExt {
}

impl MaterialExtension for TerrainLayersExt {
    fn fragment_shader() -> ShaderRef {
        SHADER_PATH.into()
    }

    fn deferred_fragment_shader() -> ShaderRef {
        SHADER_PATH.into()
    }

    fn vertex_shader() -> ShaderRef {
        SHADER_PATH.into()
    }
}

/// Asset type: `StandardMaterial` extended by [`TerrainLayersExt`].
pub type TerrainLayersMaterial = ExtendedMaterial<StandardMaterial, TerrainLayersExt>;

impl TerrainLayersExt {
    /// All graph parameters are required; order = parameter order in the editor:
    pub fn new() -> Self {
        Self {}
    }

    /// Full material: `StandardMaterial` defaults with blend/cull settings from the graph.
    pub fn material(self) -> TerrainLayersMaterial {
        ExtendedMaterial {
            base: StandardMaterial {
                alpha_mode: AlphaMode::Opaque,
                ..default()
            },
            extension: self,
        }
    }
}

pub(crate) fn register(app: &mut App) {
    app.add_plugins(MaterialPlugin::<TerrainLayersMaterial>::default());
}
