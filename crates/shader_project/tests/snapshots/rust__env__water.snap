// AUTOGENERATED by shader-editor v1 from shaders/env/water.material.ron — do not edit
use bevy::color::ColorToComponents;
use bevy::pbr::{ExtendedMaterial, MaterialExtension};
use bevy::prelude::*;
use bevy::render::render_resource::{AsBindGroup, ShaderType};
use bevy::shader::ShaderRef;

/// Asset path of the generated shader.
pub const SHADER_PATH: &str = "shaders/autogen/dir_env/mat_water.wesl";

/// Uniform block at `@binding(100)`; layout matches `WaterParams` in WESL (16 bytes).
#[derive(ShaderType, Reflect, Debug, Clone, Copy, PartialEq)]
pub struct WaterParams {
    pub inp_deep_color: Vec4,
}

impl Default for WaterParams {
    /// Default values from the graph.
    fn default() -> Self {
        Self {
            inp_deep_color: Vec4::new(0.0, 0.15, 0.3, 1.0),
        }
    }
}

/// Extension of `StandardMaterial`; use [`WaterMaterial`] as the asset type.
#[derive(Asset, AsBindGroup, Reflect, Debug, Clone)]
pub struct WaterExt {
    #[uniform(100)]
    pub params: WaterParams,
    #[texture(101)]
    #[sampler(102)]
    pub inp_normals: Handle<Image>,
}

impl MaterialExtension for WaterExt {
    fn fragment_shader() -> ShaderRef {
        SHADER_PATH.into()
    }

    fn deferred_fragment_shader() -> ShaderRef {
        SHADER_PATH.into()
    }
}

/// Asset type: `StandardMaterial` extended by [`WaterExt`].
pub type WaterMaterial = ExtendedMaterial<StandardMaterial, WaterExt>;

impl WaterExt {
    /// All graph parameters are required; order = parameter order in the editor:
    /// - `inp_normals`
    /// - `inp_deep_color`
    pub fn new(inp_normals: Handle<Image>, inp_deep_color: LinearRgba) -> Self {
        Self {
            params: WaterParams {
                inp_deep_color: inp_deep_color.to_vec4(),
            },
            inp_normals,
        }
    }

    pub fn set_inp_normals(&mut self, v: Handle<Image>) {
        self.inp_normals = v;
    }

    pub fn set_inp_deep_color(&mut self, v: LinearRgba) {
        self.params.inp_deep_color = v.to_vec4();
    }

    /// Full material: `StandardMaterial` defaults with blend/cull settings from the graph.
    pub fn material(self) -> WaterMaterial {
        ExtendedMaterial {
            base: StandardMaterial {
                alpha_mode: AlphaMode::Blend,
                ..default()
            },
            extension: self,
        }
    }
}

pub(crate) fn register(app: &mut App) {
    app.add_plugins(MaterialPlugin::<WaterMaterial>::default());
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn uniform_layout_matches_wesl() {
        assert_eq!(WaterParams::min_size().get(), 16);
    }
}
