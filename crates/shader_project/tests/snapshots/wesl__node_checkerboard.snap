import bevy_pbr::render::forward_io::VertexOutput;
import super::super::stdlib::pattern::sg_checker3;

// The game's compiled material enables this feature; after a change of parameters, texture bindings or
// World Position Offset the shader stops compiling here until the game is rebuilt.
@if(!SG_LAYOUT_740e364b)
const_assert material_layout_changed__rebuild_the_game;

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    // --- builtins ---
    let b_world_position: vec3<f32> = in.world_position.xyz;
    let b_world_normal: vec3<f32> = normalize(in.world_normal);
    // --- graph ---
    let n_n02_mask: f32 = sg_checker3(b_world_position, b_world_normal, 1.0f);
    let n_n02_color: vec3<f32> = mix(vec3<f32>(0.2, 0.2, 0.2), vec3<f32>(0.8, 0.8, 0.8), n_n02_mask);
    // --- outputs ---
    let color: vec3<f32> = vec3<f32>(n_n02_mask);
    let alpha: f32 = 1.0;
    return vec4<f32>(color, alpha);
}
