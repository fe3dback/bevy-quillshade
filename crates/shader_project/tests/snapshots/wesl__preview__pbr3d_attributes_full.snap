// AUTOGENERATED by shader-editor v1 from shaders/preview/pbr3d_attributes_full.material.ron — do not edit
// bevy 0.20, stdlib v1
// preview of node n03 (full): the material output is bypassed
import bevy_pbr::render::{pbr_fragment::pbr_input_from_standard_material, pbr_functions::alpha_discard};
@if(PREPASS_PIPELINE)
import bevy_pbr::{prepass::io::{VertexOutput, FragmentOutput}, deferred::functions::deferred_output};
@else
import bevy_pbr::render::{forward_io::{VertexOutput, FragmentOutput}, pbr_functions::{apply_pbr_lighting, main_pass_post_lighting_processing}};
import super::super::stdlib::material::MaterialAttributesPbr;
import super::super::stdlib::transform::sg_tbn;

struct Pbr3dAttributesFullParams { inp_rough: f32, _pad0: f32, _pad1: f32, _pad2: f32 }
@group(constants::MATERIAL_BIND_GROUP) @binding(100) var<uniform> params: Pbr3dAttributesFullParams;

@fragment
fn fragment(in: VertexOutput, @builtin(front_facing) is_front: bool) -> FragmentOutput {
    var pbr_input = pbr_input_from_standard_material(in, is_front);
    // --- graph ---
    let n_n03_attributes: MaterialAttributesPbr = MaterialAttributesPbr(vec3<f32>(0.2, 0.4, 0.6), 0.0f, 0.5f, 0.8f, vec3<f32>(0.0, 0.0, 0.0), 1.0f, 1.0f, vec3<f32>(0.0, 0.0, 1.0), 1.0f);
    // --- outputs ---
    pbr_input.material.base_color = vec4<f32>(n_n03_attributes.base_color, 1.0);
    pbr_input.material.metallic = n_n03_attributes.metallic;
    pbr_input.material.reflectance = vec3<f32>(n_n03_attributes.specular);
    pbr_input.material.perceptual_roughness = n_n03_attributes.roughness;
    pbr_input.material.emissive = vec4<f32>(n_n03_attributes.emissive, pbr_input.material.emissive.a);
    pbr_input.diffuse_occlusion = pbr_input.diffuse_occlusion * n_n03_attributes.ambient_occlusion;
    @if(VERTEX_TANGENTS && (!PREPASS_PIPELINE || NORMAL_PREPASS_OR_DEFERRED_PREPASS)) {
        pbr_input.N = normalize(sg_tbn(pbr_input.world_normal, in.world_tangent) * n_n03_attributes.normal);
    }
    pbr_input.material.base_color = alpha_discard(pbr_input.material.flags, pbr_input.material.alpha_cutoff, pbr_input.material.base_color);
    var out: FragmentOutput;
    @if(PREPASS_PIPELINE) {
        out = deferred_output(in, pbr_input);
    } @else {
        out.color = apply_pbr_lighting(pbr_input);
        out.color = main_pass_post_lighting_processing(pbr_input, out.color);
    }
    return out;
}
