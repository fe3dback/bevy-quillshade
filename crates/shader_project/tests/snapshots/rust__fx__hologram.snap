// AUTOGENERATED by shader-editor v1 from shaders/fx/hologram.material.ron — do not edit
use bevy::color::ColorToComponents;
use bevy::mesh::MeshVertexBufferLayoutRef;
use bevy::pbr::{MaterialPipeline, MaterialPipelineKey};
use bevy::prelude::*;
use bevy::render::render_resource::{AsBindGroup, ShaderType, RenderPipelineDescriptor, SpecializedMeshPipelineError};
use bevy::shader::ShaderRef;

/// Asset path of the generated shader.
pub const SHADER_PATH: &str = "shaders/autogen/fx/hologram.wesl";

/// Uniform block at `@binding(100)`; layout matches `HologramParams` in WESL (32 bytes).
#[derive(ShaderType, Reflect, Debug, Clone, Copy, PartialEq)]
pub struct HologramParams {
    pub color: Vec4,
    pub scan_speed: f32,
    pub _pad0: f32,
    pub _pad1: f32,
    pub _pad2: f32,
}

impl Default for HologramParams {
    /// Default values from the graph.
    fn default() -> Self {
        Self {
            color: Vec4::new(0.2, 0.8, 1.0, 1.0),
            scan_speed: 0.5,
            _pad0: 0.0,
            _pad1: 0.0,
            _pad2: 0.0,
        }
    }
}

/// Unlit 3D material (`MeshMaterial3d`).
#[derive(Asset, AsBindGroup, Reflect, Debug, Clone)]
pub struct HologramMaterial {
    #[uniform(100)]
    pub params: HologramParams,
}

impl Material for HologramMaterial {
    fn fragment_shader() -> ShaderRef {
        SHADER_PATH.into()
    }

    fn vertex_shader() -> ShaderRef {
        SHADER_PATH.into()
    }

    fn alpha_mode(&self) -> AlphaMode {
        AlphaMode::Add
    }

    fn specialize(
        _pipeline: &MaterialPipeline,
        descriptor: &mut RenderPipelineDescriptor,
        _layout: &MeshVertexBufferLayoutRef,
        _key: MaterialPipelineKey<Self>,
    ) -> Result<(), SpecializedMeshPipelineError> {
        descriptor.primitive.cull_mode = None;
        Ok(())
    }
}

impl HologramMaterial {
    /// All graph parameters are required; order = parameter order in the editor:
    /// - `color`
    /// - `scan_speed`, UI range 0.0..1.0
    pub fn new(color: LinearRgba, scan_speed: f32) -> Self {
        Self {
            params: HologramParams {
                color: color.to_vec4(),
                scan_speed,
                _pad0: 0.0,
                _pad1: 0.0,
                _pad2: 0.0,
            },
        }
    }

    pub fn set_color(&mut self, v: LinearRgba) {
        self.params.color = v.to_vec4();
    }

    pub fn set_scan_speed(&mut self, v: f32) {
        self.params.scan_speed = v;
    }
}

pub(crate) fn register(app: &mut App) {
    app.add_plugins(MaterialPlugin::<HologramMaterial>::default());
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn uniform_layout_matches_wesl() {
        assert_eq!(HologramParams::min_size().get(), 32);
    }
}
