import super::super::stdlib::scene::{sg_linear_depth, sg_scene_depth_raw};

// The game's compiled material enables this feature; after a change of parameters, texture bindings,
// World Position Offset, blend mode, two-sided or shading the shader stops compiling here until the game
// is rebuilt.
@if(!SG_LAYOUT_3e0d4723)
const_assert material_layout_changed__rebuild_the_game;

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    // --- builtins ---
    let b_frag_coord: vec4<f32> = in.position;
    // --- graph ---
    let n_n02_raw: f32 = sg_scene_depth_raw(b_frag_coord.xy);
    let n_n02_depth: f32 = sg_linear_depth(n_n02_raw);
    // --- outputs ---
    let color: vec3<f32> = vec3<f32>(n_n02_depth);
    let alpha: f32 = 1.0;
    return vec4<f32>(color, alpha);
}
