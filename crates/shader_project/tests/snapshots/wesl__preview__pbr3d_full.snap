// AUTOGENERATED by shader-editor v1 from shaders/preview/pbr3d_full.material.ron — do not edit
// bevy 0.20, stdlib v1
// preview of node n03 (full): the material output is bypassed
import bevy_pbr::render::{pbr_fragment::pbr_input_from_standard_material, pbr_functions::alpha_discard};
@if(PREPASS_PIPELINE)
import bevy_pbr::{prepass::io::{VertexOutput, FragmentOutput}, deferred::functions::deferred_output};
@else
import bevy_pbr::render::{forward_io::{VertexOutput, FragmentOutput}, pbr_functions::{apply_pbr_lighting, main_pass_post_lighting_processing}};

struct Pbr3dFullParams { inp_rough: f32, _pad0: f32, _pad1: f32, _pad2: f32 }
@group(constants::MATERIAL_BIND_GROUP) @binding(100) var<uniform> params: Pbr3dFullParams;
// The game's compiled material enables this feature; after a change of parameters, texture bindings,
// World Position Offset, blend mode, two-sided or shading the shader stops compiling here until the game
// is rebuilt.
@if(!SG_LAYOUT_e96ad2bc)
const_assert material_layout_changed__rebuild_the_game;

@fragment
fn fragment(in: VertexOutput, @builtin(front_facing) is_front: bool) -> FragmentOutput {
    var pbr_input = pbr_input_from_standard_material(in, is_front);
    // --- builtins ---
    var b_uv0: vec2<f32> = vec2<f32>(0.0);
    @if(VERTEX_UVS_A) b_uv0 = in.uv;
    // --- graph ---
    let n_n03_out: f32 = mix(0.0f, 1.0f, (b_uv0).x);
    // --- outputs ---
    pbr_input.material.base_color = vec4<f32>(vec3<f32>(n_n03_out), 1.0);
    pbr_input.material.base_color = alpha_discard(pbr_input.material.flags, pbr_input.material.alpha_cutoff, pbr_input.material.base_color);
    var out: FragmentOutput;
    @if(PREPASS_PIPELINE) {
        out = deferred_output(in, pbr_input);
    } @else {
        out.color = apply_pbr_lighting(pbr_input);
        out.color = main_pass_post_lighting_processing(pbr_input, out.color);
    }
    return out;
}
