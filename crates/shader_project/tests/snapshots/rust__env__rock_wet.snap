// AUTOGENERATED by shader-editor v1 from shaders/env/rock_wet.material.ron — do not edit
use bevy::color::ColorToComponents;
use bevy::pbr::{ExtendedMaterial, MaterialExtension};
use bevy::prelude::*;
use bevy::render::render_resource::{AsBindGroup, ShaderType};
use bevy::shader::ShaderRef;

/// Asset path of the generated shader.
pub const SHADER_PATH: &str = "shaders/autogen/dir_env/mat_rock_wet.wesl";

/// Uniform block at `@binding(100)`; layout matches `RockWetParams` in WESL (32 bytes).
#[derive(ShaderType, Reflect, Debug, Clone, Copy, PartialEq)]
pub struct RockWetParams {
    pub inp_tint: Vec4,
    pub inp_wetness: f32,
    pub inp_speed: f32,
    pub _pad0: f32,
    pub _pad1: f32,
}

impl Default for RockWetParams {
    /// Default values from the graph.
    fn default() -> Self {
        Self {
            inp_tint: Vec4::new(0.9, 0.85, 0.8, 1.0),
            inp_wetness: 0.3,
            inp_speed: 1.0,
            _pad0: 0.0,
            _pad1: 0.0,
        }
    }
}

/// Extension of `StandardMaterial`; use [`RockWetMaterial`] as the asset type.
#[derive(Asset, AsBindGroup, Reflect, Debug, Clone)]
pub struct RockWetExt {
    #[uniform(100)]
    pub params: RockWetParams,
    #[texture(101)]
    #[sampler(102)]
    pub inp_albedo: Handle<Image>,
    #[texture(103)]
    #[sampler(104)]
    pub inp_normal_map: Handle<Image>,
}

impl MaterialExtension for RockWetExt {
    fn fragment_shader() -> ShaderRef {
        SHADER_PATH.into()
    }

    fn deferred_fragment_shader() -> ShaderRef {
        SHADER_PATH.into()
    }
}

/// Asset type: `StandardMaterial` extended by [`RockWetExt`].
pub type RockWetMaterial = ExtendedMaterial<StandardMaterial, RockWetExt>;

impl RockWetExt {
    /// All graph parameters are required; order = parameter order in the editor:
    /// - `inp_albedo`
    /// - `inp_normal_map`
    /// - `inp_tint`
    /// - `inp_wetness` (group Surface), UI range 0.0..1.0
    /// - `inp_speed`, UI range 0.0..10.0
    pub fn new(inp_albedo: Handle<Image>, inp_normal_map: Handle<Image>, inp_tint: LinearRgba, inp_wetness: f32, inp_speed: f32) -> Self {
        Self {
            params: RockWetParams {
                inp_tint: inp_tint.to_vec4(),
                inp_wetness,
                inp_speed,
                _pad0: 0.0,
                _pad1: 0.0,
            },
            inp_albedo,
            inp_normal_map,
        }
    }

    pub fn set_inp_albedo(&mut self, v: Handle<Image>) {
        self.inp_albedo = v;
    }

    pub fn set_inp_normal_map(&mut self, v: Handle<Image>) {
        self.inp_normal_map = v;
    }

    pub fn set_inp_tint(&mut self, v: LinearRgba) {
        self.params.inp_tint = v.to_vec4();
    }

    pub fn set_inp_wetness(&mut self, v: f32) {
        self.params.inp_wetness = v;
    }

    pub fn set_inp_speed(&mut self, v: f32) {
        self.params.inp_speed = v;
    }

    /// Full material: `StandardMaterial` defaults with blend/cull settings from the graph.
    pub fn material(self) -> RockWetMaterial {
        ExtendedMaterial {
            base: StandardMaterial {
                alpha_mode: AlphaMode::Mask(0.3333),
                ..default()
            },
            extension: self,
        }
    }
}

pub(crate) fn register(app: &mut App) {
    app.add_plugins(MaterialPlugin::<RockWetMaterial>::default());
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn uniform_layout_matches_wesl() {
        assert_eq!(RockWetParams::min_size().get(), 32);
    }
}
