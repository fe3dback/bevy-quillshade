// AUTOGENERATED by shader-editor v1 from shaders/env/flag.material.ron — do not edit
use bevy::color::ColorToComponents;
use bevy::pbr::{ExtendedMaterial, MaterialExtension};
use bevy::prelude::*;
use bevy::render::render_resource::{AsBindGroup, ShaderType};
use bevy::shader::ShaderRef;

/// Asset path of the generated shader.
pub const SHADER_PATH: &str = "shaders/autogen/dir_env/mat_flag.wesl";

/// Uniform block at `@binding(100)`; layout matches `FlagParams` in WESL (32 bytes).
#[derive(ShaderType, Reflect, Debug, Clone, Copy, PartialEq)]
pub struct FlagParams {
    pub inp_color: Vec4,
    pub inp_strength: f32,
    pub _pad0: f32,
    pub _pad1: f32,
    pub _pad2: f32,
}

impl Default for FlagParams {
    /// Default values from the graph.
    fn default() -> Self {
        Self {
            inp_color: Vec4::new(0.8, 0.1, 0.1, 1.0),
            inp_strength: 0.2,
            _pad0: 0.0,
            _pad1: 0.0,
            _pad2: 0.0,
        }
    }
}

/// Extension of `StandardMaterial`; use [`FlagMaterial`] as the asset type.
#[derive(Asset, AsBindGroup, Reflect, Debug, Clone)]
pub struct FlagExt {
    #[uniform(100)]
    pub params: FlagParams,
}

impl MaterialExtension for FlagExt {
    fn fragment_shader() -> ShaderRef {
        SHADER_PATH.into()
    }

    fn deferred_fragment_shader() -> ShaderRef {
        SHADER_PATH.into()
    }

    fn vertex_shader() -> ShaderRef {
        SHADER_PATH.into()
    }
}

/// Asset type: `StandardMaterial` extended by [`FlagExt`].
pub type FlagMaterial = ExtendedMaterial<StandardMaterial, FlagExt>;

impl FlagExt {
    /// All graph parameters are required; order = parameter order in the editor:
    /// - `inp_color`
    /// - `inp_strength`, UI range 0.0..1.0
    pub fn new(inp_color: LinearRgba, inp_strength: f32) -> Self {
        Self {
            params: FlagParams {
                inp_color: inp_color.to_vec4(),
                inp_strength,
                _pad0: 0.0,
                _pad1: 0.0,
                _pad2: 0.0,
            },
        }
    }

    pub fn set_inp_color(&mut self, v: LinearRgba) {
        self.params.inp_color = v.to_vec4();
    }

    pub fn set_inp_strength(&mut self, v: f32) {
        self.params.inp_strength = v;
    }

    /// Full material: `StandardMaterial` defaults with blend/cull settings from the graph.
    pub fn material(self) -> FlagMaterial {
        ExtendedMaterial {
            base: StandardMaterial {
                alpha_mode: AlphaMode::Opaque,
                double_sided: true,
                cull_mode: None,
                ..default()
            },
            extension: self,
        }
    }
}

pub(crate) fn register(app: &mut App) {
    app.add_plugins(MaterialPlugin::<FlagMaterial>::default());
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn uniform_layout_matches_wesl() {
        assert_eq!(FlagParams::min_size().get(), 32);
    }
}
