// AUTOGENERATED by shader-editor v1 from shaders/nodes/node_camera_vector_ws.material.ron — do not edit
// bevy 0.20, stdlib v1
import bevy_pbr::render::forward_io::VertexOutput;
import bevy_pbr::render::mesh_view_bindings::view;

// The game's compiled material enables this feature; after a change of parameters, texture bindings,
// World Position Offset, blend mode, two-sided or shading the shader stops compiling here until the game
// is rebuilt.
@if(!SG_LAYOUT_3e0d4723)
const_assert material_layout_changed__rebuild_the_game;

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    // --- builtins ---
    let b_world_position: vec3<f32> = in.world_position.xyz;
    let b_camera_position: vec3<f32> = view.world_position;
    // --- graph ---
    let n_n02_out: vec3<f32> = normalize(b_camera_position - b_world_position);
    // --- outputs ---
    let color: vec3<f32> = n_n02_out;
    let alpha: f32 = 1.0;
    return vec4<f32>(color, alpha);
}
