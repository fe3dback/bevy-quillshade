import bevy_pbr::render::forward_io::VertexOutput;
import bevy_pbr::render::mesh_functions::get_world_from_local;

// The game's compiled material enables this feature; after a change of parameters, texture bindings,
// World Position Offset, blend mode, two-sided or shading the shader stops compiling here until the game
// is rebuilt.
@if(!SG_LAYOUT_3e0d4723)
const_assert material_layout_changed__rebuild_the_game;

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    // --- builtins ---
    var b_world_from_local: mat4x4<f32> = mat4x4<f32>(vec4<f32>(1.0, 0.0, 0.0, 0.0), vec4<f32>(0.0, 1.0, 0.0, 0.0), vec4<f32>(0.0, 0.0, 1.0, 0.0), vec4<f32>(0.0, 0.0, 0.0, 1.0));
    @if(VERTEX_OUTPUT_INSTANCE_INDEX) b_world_from_local = get_world_from_local(in.instance_index);
    // --- outputs ---
    let color: vec3<f32> = b_world_from_local[3].xyz;
    let alpha: f32 = 1.0;
    return vec4<f32>(color, alpha);
}
