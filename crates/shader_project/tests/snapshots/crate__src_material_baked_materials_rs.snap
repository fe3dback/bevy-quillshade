    }

    impl Group {
        /// Reserves a handle in `Assets<M>` for every material (the loader inserts the materials there).
        pub(crate) fn reserve(world: &mut World) -> Self {
            Self {
                dir_loop: dir_loop::Group::reserve(world),
            }
        }
    }

    pub mod dir_loop {
        use bevy::prelude::*;

        /// Materials of `kw/loop/`.
        #[derive(Clone, Debug)]
        pub struct Group {
            pub mat_type: Handle<crate::material::materials::dir_kw::dir_loop::mat_type::TypeMaterial>,
        }

        impl Group {
            /// Reserves a handle in `Assets<M>` for every material (the loader inserts the materials there).
