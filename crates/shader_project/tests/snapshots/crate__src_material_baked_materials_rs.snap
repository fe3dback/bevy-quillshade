// AUTOGENERATED by shader-editor v1 — do not edit
//! [`BakedMaterials`]: a handle per generated material, nested by folder (design §3.1).

use std::collections::{BTreeMap, HashMap};

use bevy::asset::uuid::Uuid;
use bevy::prelude::*;

use super::MaterialValues;

/// Every generated material, nested by folder (`baked.env.rock_wet`). The handles are reserved when the
/// plugin is built; `BakedMaterialsLoader::load` inserts the materials behind them.
#[derive(Resource, Clone, Debug)]
pub struct BakedMaterials {
    pub env: dir_env::Group,
    pub fx: dir_fx::Group,
    pub kw: dir_kw::Group,
    pub ui: dir_ui::Group,
    /// Every material by asset id (`env/rock_wet`: its path under `quillshade/material/` without
    /// `.material.ron`), for game data that names materials; [`BakedMaterials::get`] gives the typed handle.
    pub by_path: HashMap<String, UntypedHandle>,
    /// Every material by asset UUID (the `id` of its `.material.ron`, ADR 0047), which survives renames and
    /// moves; [`BakedMaterials::get_by_id`] gives the typed handle. A material without a valid id is not listed.
    pub by_id: BTreeMap<Uuid, UntypedHandle>,
}

impl BakedMaterials {
    /// Asset ids (`env/rock_wet`) of every material, as keyed in the manifest.
    pub(crate) const IDS: &[&str] = &[
        "env/flag",
        "env/rock_wet",
        "env/terrain_layers",
        "env/tex_layers",
        "env/water",
        "fx/coords",
        "fx/curve_bands",
        "fx/global_tint",
        "fx/hologram",
        "fx/user_node",
        "kw/loop/type",
        "ui/dissolve",
    ];

    /// Reserves a handle in `Assets<M>` for every material (the loader inserts the materials there).
    pub(crate) fn reserve(world: &mut World) -> Self {
        let mut s = Self {
            env: dir_env::Group::reserve(world),
            fx: dir_fx::Group::reserve(world),
            kw: dir_kw::Group::reserve(world),
            ui: dir_ui::Group::reserve(world),
            by_path: HashMap::new(),
            by_id: BTreeMap::new(),
        };
        s.by_path = HashMap::from([
            ("env/flag".to_string(), s.env.flag.clone().untyped()),
            ("env/rock_wet".to_string(), s.env.rock_wet.clone().untyped()),
            ("env/terrain_layers".to_string(), s.env.terrain_layers.clone().untyped()),
            ("env/tex_layers".to_string(), s.env.tex_layers.clone().untyped()),
            ("env/water".to_string(), s.env.water.clone().untyped()),
            ("fx/coords".to_string(), s.fx.coords.clone().untyped()),
            ("fx/curve_bands".to_string(), s.fx.curve_bands.clone().untyped()),
            ("fx/global_tint".to_string(), s.fx.global_tint.clone().untyped()),
            ("fx/hologram".to_string(), s.fx.hologram.clone().untyped()),
            ("fx/user_node".to_string(), s.fx.user_node.clone().untyped()),
            ("kw/loop/type".to_string(), s.kw.dir_loop.mat_type.clone().untyped()),
            ("ui/dissolve".to_string(), s.ui.dissolve.clone().untyped()),
        ]);
        s.by_id = BTreeMap::from([
            (Uuid::from_u128(0x019b76daa80071ce944c895254e237f9), s.env.flag.clone().untyped()), // 019b76da-a800-71ce-944c-895254e237f9 env/flag
            (Uuid::from_u128(0x019b76daa80075c1939b7e0a98afeaba), s.env.rock_wet.clone().untyped()), // 019b76da-a800-75c1-939b-7e0a98afeaba env/rock_wet
            (Uuid::from_u128(0x019b76daa8007b7784002f55674efa6e), s.env.terrain_layers.clone().untyped()), // 019b76da-a800-7b77-8400-2f55674efa6e env/terrain_layers
            (Uuid::from_u128(0x019b76daa800771899ad01ec0fcbe9da), s.env.tex_layers.clone().untyped()), // 019b76da-a800-7718-99ad-01ec0fcbe9da env/tex_layers
            (Uuid::from_u128(0x019b76daa8007876a94ecc00b88e5383), s.env.water.clone().untyped()), // 019b76da-a800-7876-a94e-cc00b88e5383 env/water
            (Uuid::from_u128(0x019b76daa80072cd898439eefb8c9668), s.fx.coords.clone().untyped()), // 019b76da-a800-72cd-8984-39eefb8c9668 fx/coords
            (Uuid::from_u128(0x019b76daa8007c36ada55de79099892e), s.fx.curve_bands.clone().untyped()), // 019b76da-a800-7c36-ada5-5de79099892e fx/curve_bands
            (Uuid::from_u128(0x019b76daa8007bd6988309fe5ca761db), s.fx.global_tint.clone().untyped()), // 019b76da-a800-7bd6-9883-09fe5ca761db fx/global_tint
            (Uuid::from_u128(0x019b76daa8007944befc7d739007bf84), s.fx.hologram.clone().untyped()), // 019b76da-a800-7944-befc-7d739007bf84 fx/hologram
            (Uuid::from_u128(0x019b76daa80074c6aca2b7e261c52918), s.fx.user_node.clone().untyped()), // 019b76da-a800-74c6-aca2-b7e261c52918 fx/user_node
            (Uuid::from_u128(0x019b76daa8007dd9aa2b0e41c8fe9b3c), s.kw.dir_loop.mat_type.clone().untyped()), // 019b76da-a800-7dd9-aa2b-0e41c8fe9b3c kw/loop/type
            (Uuid::from_u128(0x019b76daa8007d80b62f718dfe4b0ade), s.ui.dissolve.clone().untyped()), // 019b76da-a800-7d80-b62f-718dfe4b0ade ui/dissolve
        ]);
        s
    }

    /// Material `id` (`env/rock_wet`) as `Handle<M>`, `M` being its asset type (`RockWetMaterial`); `None` for an
    /// unknown id or another type.
    pub fn get<M: Asset>(&self, id: &str) -> Option<Handle<M>> {
        self.by_path.get(id)?.clone().try_typed().ok()
    }

    /// Material `id` (its asset UUID) as `Handle<M>`, `M` being its asset type; `None` for an unknown id or another
    /// type.
    pub fn get_by_id<M: Asset>(&self, id: Uuid) -> Option<Handle<M>> {
        self.by_id.get(&id)?.clone().try_typed().ok()
    }

    /// Registers every material asset type that is not registered yet (headless: no material plugins).
    pub(crate) fn init_assets(app: &mut App) {
        super::init_asset::<crate::material::materials::dir_env::mat_flag::FlagMaterial>(app);
        super::init_asset::<crate::material::materials::dir_env::mat_rock_wet::RockWetMaterial>(app);
        super::init_asset::<crate::material::materials::dir_env::mat_terrain_layers::TerrainLayersMaterial>(app);
        super::init_asset::<crate::material::materials::dir_env::mat_tex_layers::TexLayersMaterial>(app);
        super::init_asset::<crate::material::materials::dir_env::mat_water::WaterMaterial>(app);
        super::init_asset::<crate::material::materials::dir_fx::mat_coords::CoordsMaterial>(app);
        super::init_asset::<crate::material::materials::dir_fx::mat_curve_bands::CurveBandsMaterial>(app);
        super::init_asset::<crate::material::materials::dir_fx::mat_global_tint::GlobalTintMaterial>(app);
        super::init_asset::<crate::material::materials::dir_fx::mat_hologram::HologramMaterial>(app);
        super::init_asset::<crate::material::materials::dir_fx::mat_user_node::UserNodeMaterial>(app);
        super::init_asset::<crate::material::materials::dir_kw::dir_loop::mat_type::TypeMaterial>(app);
        super::init_asset::<crate::material::materials::dir_ui::mat_dissolve::DissolveMaterial>(app);
    }

    /// Builds material `id` from `v` (images through `tex`) and inserts it at its reserved handle.
    pub(crate) fn insert(&self, world: &mut World, id: &str, v: &MaterialValues, tex: &dyn Fn(&str) -> Handle<Image>) {
        match id {
            "env/flag" => super::insert_material(world, &self.env.flag, crate::material::materials::dir_env::mat_flag::FlagExt::from_values(v, tex).material()),
            "env/rock_wet" => super::insert_material(world, &self.env.rock_wet, crate::material::materials::dir_env::mat_rock_wet::RockWetExt::from_values(v, tex).material()),
            "env/terrain_layers" => super::insert_material(world, &self.env.terrain_layers, crate::material::materials::dir_env::mat_terrain_layers::TerrainLayersExt::from_values(v, tex).material()),
            "env/tex_layers" => super::insert_material(world, &self.env.tex_layers, crate::material::materials::dir_env::mat_tex_layers::TexLayersExt::from_values(v, tex).material()),
            "env/water" => super::insert_material(world, &self.env.water, crate::material::materials::dir_env::mat_water::WaterExt::from_values(v, tex).material()),
            "fx/coords" => super::insert_material(world, &self.fx.coords, crate::material::materials::dir_fx::mat_coords::CoordsMaterial::from_values(v, tex)),
            "fx/curve_bands" => super::insert_material(world, &self.fx.curve_bands, crate::material::materials::dir_fx::mat_curve_bands::CurveBandsMaterial::from_values(v, tex)),
            "fx/global_tint" => super::insert_material(world, &self.fx.global_tint, crate::material::materials::dir_fx::mat_global_tint::GlobalTintMaterial::from_values(v, tex)),
            "fx/hologram" => super::insert_material(world, &self.fx.hologram, crate::material::materials::dir_fx::mat_hologram::HologramMaterial::from_values(v, tex)),
            "fx/user_node" => super::insert_material(world, &self.fx.user_node, crate::material::materials::dir_fx::mat_user_node::UserNodeMaterial::from_values(v, tex)),
            "kw/loop/type" => super::insert_material(world, &self.kw.dir_loop.mat_type, crate::material::materials::dir_kw::dir_loop::mat_type::TypeMaterial::from_values(v, tex)),
            "ui/dissolve" => super::insert_material(world, &self.ui.dissolve, crate::material::materials::dir_ui::mat_dissolve::DissolveMaterial::from_values(v, tex)),
            _ => warn!("baked materials: material `{id}` is not compiled into the game"),
        }
    }

    /// Ids of the materials whose handle has no asset yet.
    #[doc(hidden)]
    pub fn unresolved(&self, world: &World) -> Vec<&'static str> {
        let mut out = Vec::new();
        if !super::has_material(world, &self.env.flag) {
            out.push("env/flag");
        }
        if !super::has_material(world, &self.env.rock_wet) {
            out.push("env/rock_wet");
        }
        if !super::has_material(world, &self.env.terrain_layers) {
            out.push("env/terrain_layers");
        }
        if !super::has_material(world, &self.env.tex_layers) {
            out.push("env/tex_layers");
        }
        if !super::has_material(world, &self.env.water) {
            out.push("env/water");
        }
        if !super::has_material(world, &self.fx.coords) {
            out.push("fx/coords");
        }
        if !super::has_material(world, &self.fx.curve_bands) {
            out.push("fx/curve_bands");
        }
        if !super::has_material(world, &self.fx.global_tint) {
            out.push("fx/global_tint");
        }
        if !super::has_material(world, &self.fx.hologram) {
            out.push("fx/hologram");
        }
        if !super::has_material(world, &self.fx.user_node) {
            out.push("fx/user_node");
        }
        if !super::has_material(world, &self.kw.dir_loop.mat_type) {
            out.push("kw/loop/type");
        }
        if !super::has_material(world, &self.ui.dissolve) {
            out.push("ui/dissolve");
        }
        out
    }
}

pub mod dir_env {
    use bevy::prelude::*;

    /// Materials of `env/`.
    #[derive(Clone, Debug)]
    pub struct Group {
        pub flag: Handle<crate::material::materials::dir_env::mat_flag::FlagMaterial>,
        pub rock_wet: Handle<crate::material::materials::dir_env::mat_rock_wet::RockWetMaterial>,
        pub terrain_layers: Handle<crate::material::materials::dir_env::mat_terrain_layers::TerrainLayersMaterial>,
        pub tex_layers: Handle<crate::material::materials::dir_env::mat_tex_layers::TexLayersMaterial>,
        pub water: Handle<crate::material::materials::dir_env::mat_water::WaterMaterial>,
    }

    impl Group {
        /// Reserves a handle in `Assets<M>` for every material (the loader inserts the materials there).
        pub(crate) fn reserve(world: &mut World) -> Self {
            Self {
                flag: world.resource::<Assets<crate::material::materials::dir_env::mat_flag::FlagMaterial>>().reserve_handle(),
                rock_wet: world.resource::<Assets<crate::material::materials::dir_env::mat_rock_wet::RockWetMaterial>>().reserve_handle(),
                terrain_layers: world.resource::<Assets<crate::material::materials::dir_env::mat_terrain_layers::TerrainLayersMaterial>>().reserve_handle(),
                tex_layers: world.resource::<Assets<crate::material::materials::dir_env::mat_tex_layers::TexLayersMaterial>>().reserve_handle(),
                water: world.resource::<Assets<crate::material::materials::dir_env::mat_water::WaterMaterial>>().reserve_handle(),
            }
        }
    }
}

