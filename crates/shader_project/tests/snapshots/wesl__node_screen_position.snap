import bevy_pbr::render::forward_io::VertexOutput;
import bevy_pbr::render::mesh_view_bindings::view;

// The game's compiled material enables this feature; after a change of parameters, texture bindings or
// World Position Offset the shader stops compiling here until the game is rebuilt.
@if(!SG_LAYOUT_740e364b)
const_assert material_layout_changed__rebuild_the_game;

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    // --- builtins ---
    let b_frag_coord: vec4<f32> = in.position;
    let b_view_size: vec2<f32> = view.viewport.zw;
    // --- graph ---
    let n_n02_viewport_uv: vec2<f32> = (b_frag_coord.xy / b_view_size);
    let n_n03_out: vec3<f32> = vec3<f32>(n_n02_viewport_uv, 0.0f);
    // --- outputs ---
    let color: vec3<f32> = n_n03_out;
    let alpha: f32 = 1.0;
    return vec4<f32>(color, alpha);
}
