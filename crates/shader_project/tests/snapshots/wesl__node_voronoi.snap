import bevy_pbr::render::forward_io::VertexOutput;
import super::super::stdlib::noise::sg_voronoi3;

// The game's compiled material enables this feature; after a change of parameters, texture bindings,
// World Position Offset, blend mode, two-sided or shading the shader stops compiling here until the game
// is rebuilt.
@if(!SG_LAYOUT_3e0d4723)
const_assert material_layout_changed__rebuild_the_game;

@fragment
fn fragment(in: VertexOutput) -> @location(0) vec4<f32> {
    // --- builtins ---
    let b_world_position: vec3<f32> = in.world_position.xyz;
    // --- graph ---
    let n_n02_v_: vec4<f32> = sg_voronoi3(b_world_position * 1.0f, 1.0f, 0.0f);
    // --- outputs ---
    let color: vec3<f32> = vec3<f32>(n_n02_v_.x);
    let alpha: f32 = 1.0;
    return vec4<f32>(color, alpha);
}
