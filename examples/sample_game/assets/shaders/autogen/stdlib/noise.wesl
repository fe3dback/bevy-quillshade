// AUTOGENERATED by shader-editor v1 from stdlib::noise — do not edit
// stdlib v1

fn sg_hash31(p: vec3<f32>) -> f32 {
    var q = fract(p * 0.1031);
    q += dot(q, q.zyx + 31.32);
    return fract((q.x + q.y) * q.z);
}

fn sg_hash33(p: vec3<f32>) -> vec3<f32> {
    var q = fract(p * vec3<f32>(0.1031, 0.1030, 0.0973));
    q += dot(q, q.yxz + 33.33);
    return fract((q.xxy + q.yxx) * q.zyx);
}

// Value noise in 0..1.
fn sg_value_noise3(p: vec3<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (3.0 - 2.0 * f);
    let x00 = mix(sg_hash31(i), sg_hash31(i + vec3<f32>(1.0, 0.0, 0.0)), u.x);
    let x10 = mix(sg_hash31(i + vec3<f32>(0.0, 1.0, 0.0)), sg_hash31(i + vec3<f32>(1.0, 1.0, 0.0)), u.x);
    let x01 = mix(sg_hash31(i + vec3<f32>(0.0, 0.0, 1.0)), sg_hash31(i + vec3<f32>(1.0, 0.0, 1.0)), u.x);
    let x11 = mix(sg_hash31(i + vec3<f32>(0.0, 1.0, 1.0)), sg_hash31(i + vec3<f32>(1.0, 1.0, 1.0)), u.x);
    return mix(mix(x00, x10, u.y), mix(x01, x11, u.y), u.z);
}

fn sg_grad3(i: vec3<f32>, f: vec3<f32>) -> f32 {
    return dot(sg_hash33(i) * 2.0 - 1.0, f);
}

// Gradient (Perlin-style) noise remapped to 0..1.
fn sg_perlin_noise3(p: vec3<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let e = vec2<f32>(1.0, 0.0);
    let x00 = mix(sg_grad3(i, f), sg_grad3(i + e.xyy, f - e.xyy), u.x);
    let x10 = mix(sg_grad3(i + e.yxy, f - e.yxy), sg_grad3(i + e.xxy, f - e.xxy), u.x);
    let x01 = mix(sg_grad3(i + e.yyx, f - e.yyx), sg_grad3(i + e.xyx, f - e.xyx), u.x);
    let x11 = mix(sg_grad3(i + e.yxx, f - e.yxx), sg_grad3(i + e.xxx, f - e.xxx), u.x);
    return saturate(mix(mix(x00, x10, u.y), mix(x01, x11, u.y), u.z) * 0.5 + 0.5);
}
